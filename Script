-- Core Game Automation Logic Loops
local function GetOptimalEggTarget()
    local container = Workspace:FindFirstChild("Eggs") or Workspace:FindFirstChild("Map")
    if not container then return nil end
    
    local bestTarget = nil
    local maxScore = -1
    
    for _, item in ipairs(container:GetDescendants()) do
        if item:IsA("Model") and item.PrimaryPart then
            local score = 1
            if getgenv().FernzConfig.StealBestEgg and item.Name:lower():find("best") then score = 15000
            elseif getgenv().FernzConfig.StealBigEgg and item.Name:lower():find("big") then score = 8000
            elseif getgenv().FernzConfig.StealBestValue then score = item:GetAttribute("Value") or 200 end
            
            if score > maxScore then
                maxScore = score
                bestTarget = item.PrimaryPart
            end
        end
    end
    return bestTarget
end

