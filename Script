-- Core Execution Loops (Auto Farm & Treadmill & Speed)
local function GetTargetEggPart()
    local folder = Workspace:FindFirstChild("Eggs") or Workspace:FindFirstChild("Map")
    if not folder then return nil end
    
    local bestPart = nil
    local maxVal = -1
    
    for _, egg in ipairs(folder:GetDescendants()) do
        if egg:IsA("Model") and egg.PrimaryPart then
            local score = 1
            if getgenv().FernzConfig.StealBestEgg and egg.Name:lower():find("best") then
                score = 9999
            elseif getgenv().FernzConfig.StealBigEgg and egg.Name:lower():find("big") then
                score = 5000
            elseif getgenv().FernzConfig.StealBestValue then
                score = egg:GetAttribute("Value") or 100
            end
            
            if score > maxVal then
                maxVal = score
                bestPart = egg.PrimaryPart
            end
        end
    end
    return bestPart
end

